# ==============================================================================
# Draftroom Live - Environment Configuration Template
# ==============================================================================

# PostgreSQL Database Connection String
# Matches credentials in docker-compose.yml
DATABASE_URL="postgresql://draftroom:password@localhost:5432/draftroom_live?schema=public"

# Redis Server Configuration (for horizontal scaling and pub/sub)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Collab Server (Node.js Hocuspocus & Socket.io)
PORT=1234
COLLAB_PORT=1234

# Next.js Web App Public WebSocket & Collab Endpoints
NEXT_PUBLIC_COLLAB_WS_URL="ws://localhost:1234"
NEXT_PUBLIC_COLLAB_SERVER_URL="http://localhost:1234"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="draftroom-live-secret-super-secure-key-32chars"

# Optional Email Notification Provider
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="no-reply@draftroom.live"
