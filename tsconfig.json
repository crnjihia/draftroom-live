{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "baseUrl": ".",
    "paths": {
      "@studyroom/shared": ["apps/shared/src/index"],
      "@studyroom/shared/*": ["apps/shared/src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "e2e/**/*"
  ],
  "exclude": [
    "node_modules",
    "apps"
  ]
}
