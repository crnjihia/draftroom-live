{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "noEmit": true,
    "composite": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"]
  },
  "references": [
    { "path": "./apps/web" },
    { "path": "./apps/collab-server" },
    { "path": "./apps/shared" }
  ]
}
